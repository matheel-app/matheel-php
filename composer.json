{
  "name": "matheel/matheel-php",
  "description": "Official client for the Matheel ZATCA Phase 2 e-invoicing API (Saudi Arabia, Fatoora): file invoices with a device token, decode the QR, verify callbacks.",
  "type": "library",
  "keywords": [
    "zatca",
    "fatoora",
    "e-invoicing",
    "saudi",
    "vat",
    "einvoice"
  ],
  "homepage": "https://matheel.app/en/zatca-integration/php",
  "license": "MIT",
  "authors": [
    {
      "name": "Matheel",
      "email": "hello@matheel.app",
      "homepage": "https://matheel.app"
    }
  ],
  "support": {
    "source": "https://github.com/matheel-app/matheel-php",
    "issues": "https://github.com/matheel-app/matheel-php/issues",
    "docs": "https://matheel.app/en/docs",
    "email": "hello@matheel.app"
  },
  "require": {
    "php": ">=7.4",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Matheel\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "archive": {
    "exclude": [
      "/tests",
      "/vendor",
      "/.gitignore",
      "/.gitattributes"
    ]
  }
}
